rules_version = '2';
// mylifeHQ: each person can read and write only their own space,
// users/{their uid}/... Everything else, including the old shared
// "penguin73" space, is closed. Paste into Firebase console →
// Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
